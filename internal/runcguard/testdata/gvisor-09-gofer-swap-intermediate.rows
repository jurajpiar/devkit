      ext4 /var/lib/devkit-docker/run at /root/s
      ext4 /var/lib/devkit-docker/.local/share/docker/containers/a8cb54ed3a84308a682808c5b67e6987c3756a48096fe78bd1ece772df8883e3/resolv.conf at /root/etc/resolv.conf
      ext4 /var/lib/devkit-docker/.local/share/docker/containers/a8cb54ed3a84308a682808c5b67e6987c3756a48096fe78bd1ece772df8883e3/hostname at /root/etc/hostname
      ext4 /var/lib/devkit-docker/.local/share/docker/containers/a8cb54ed3a84308a682808c5b67e6987c3756a48096fe78bd1ece772df8883e3/hosts at /root/etc/hosts
